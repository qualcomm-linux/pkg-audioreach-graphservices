# SPF provides compile-time protocol headers only.  The empty shared object is
# retained for compatibility with consumers that link against -lar-spfhdrs, so
# it legitimately has no DT_NEEDED entries.
# https://github.com/AudioReach/audioreach-graphservices/issues/104
libar-spfhdrs1: shared-library-lacks-prerequisites [usr/lib/aarch64-linux-gnu/libar-spfhdrs.so.1.0.0]

# Upstream has not yet defined a stable public ABI/export surface, so a symbols
# file would incorrectly treat internal symbols as supported API.
# https://github.com/AudioReach/audioreach-graphservices/issues/105
libar-spfhdrs1: no-symbols-control-file usr/lib/aarch64-linux-gnu/libar-spfhdrs.so.1.0.0
