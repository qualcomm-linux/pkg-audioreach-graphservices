#!/usr/bin/make -f

export DEB_LDFLAGS_MAINT_APPEND = -Wl,-z,defs

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- --with-glib --without-cutils --with-syslog --without-dummy_diag --with-libdiag_headers --with-qcom --with-audio_dma_support --without-ats_transport_tcp_ip --without-ats_data_logging --with-msm-audio-ion-disable
